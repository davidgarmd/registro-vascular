# Copia este fichero como .env (instalar-servidor.sh lo hace por ti) y rellénalo.
# El fichero .env contiene contraseñas: nunca lo subas a GitHub.

# Dominio con el que se accede al registro (debe apuntar a la IP del servidor).
DOMINIO=registro.midominio.es
# Correo para avisos de Let's Encrypt sobre el certificado HTTPS.
EMAIL_ADMIN=tu-correo@ejemplo.com

# Dirección usada en los enlaces de los correos de recordatorio.
REGISTRO_BASE_URL=https://registro.midominio.es

# Correo saliente (ejemplo con Gmail y una contraseña de aplicación).
REGISTRO_MAIL_SERVER=smtp.gmail.com
REGISTRO_MAIL_PORT=587
REGISTRO_MAIL_USE_TLS=true
REGISTRO_MAIL_USERNAME=registro.vascular.xxx@gmail.com
REGISTRO_MAIL_PASSWORD=abcdefghijklmnop
REGISTRO_MAIL_FROM=registro.vascular.xxx@gmail.com

# Hora (0-23, hora del servidor) a partir de la cual se envían los recordatorios del día.
REGISTRO_RECORDATORIO_HORA=8
TZ=Europe/Madrid
